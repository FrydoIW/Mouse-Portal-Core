############################################################
# Spring Boot / Java
############################################################
# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle
build/
.gradle/
!**/src/main/**/build/
!**/src/test/**/build/

# Logs
logs/
*.log
*.tmp

# JVM crash logs
hs_err_pid*
replay_pid*

############################################################
# Spring profiles / local secrets (IMPORTANT)
############################################################
# Local profile files
**/src/main/resources/application-local.properties
**/src/main/resources/application-local.yml
**/src/main/resources/application-local.yaml

# Common variants people use
**/src/main/resources/application-*.local.properties
**/src/main/resources/application-*.local.yml
**/src/main/resources/application-*.local.yaml
**/src/main/resources/*-local.properties
**/src/main/resources/*-local.yml
**/src/main/resources/*-local.yaml

# Env files (Docker/CLI)
.env
.env.*
!.env.example

# Secret keys / certificates (if you ever add them)
*.pem
*.key
*.crt
*.p12
*.jks

############################################################
# IDEs
############################################################
### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr
out/

### VS Code ###
.vscode/

### STS / Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

############################################################
# OS junk
############################################################
.DS_Store
Thumbs.db
desktop.ini

############################################################
# Misc
############################################################
HELP.md
